# Port number
PORT=3000

# URL of the Mongo DB
MONGODB_URL=mongodb://127.0.0.1:27017/node-boilerplate

# JWT
# JWT secret key
JWT_SECRET=thisisasamplesecret
# Number of minutes after which an access token expires
JWT_ACCESS_EXPIRATION_MINUTES=30
# Number of days after which a refresh token expires
JWT_REFRESH_EXPIRATION_DAYS=30
# Number of minutes after which a reset password token expires
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
# Number of minutes after which a verify email token expires
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# SMTP configuration options for the email service
# For testing, you can use a fake SMTP service like Ethereal: https://ethereal.email/create
SMTP_HOST=email-server
SMTP_PORT=587
SMTP_USERNAME=email-server-username
SMTP_PASSWORD=email-server-password
EMAIL_FROM=support@yourapp.com

# Optional cache (memory | redis)
# CACHE_TYPE=memory
# Redis: required for shared cache; also enables Socket.IO Redis adapter so alert pushes work across multiple API instances.
# Local Docker Compose Redis: redis://127.0.0.1:6379
# REDIS_URL=
# REDIS_ENDPOINT=
# REDIS_PORT=6379

# --- Data residency (EU/GDPR) ---
# Controls where GDPR-regulated data is routed once EU infrastructure is provisioned.
# US (default): all storage uses AWS_REGION / US bucket — current production behavior.
# AUTO: route GDPR-jurisdiction data to EU endpoints when EU_* vars are set.
# EU: same GDPR→EU routing as AUTO (reserved for explicit EU-only deployments).
DATA_RESIDENCY_MODE=US

# Primary AWS region for US deployment (also used when residency mode is US or non-GDPR data).
AWS_REGION=us-east-2

# Target AWS region for EU-resident resources (S3, future EU services). Default: eu-central-1.
# Required for EU/GDPR deployment once EU resources exist.
# AWS_EU_REGION=eu-central-1

# EU MongoDB connection string. Required for EU/GDPR deployment; leave empty until provisioned.
# EU_MONGODB_URI=

# EU S3 bucket for GDPR-regulated object storage. Required for EU/GDPR deployment; leave empty until provisioned.
# When DATA_RESIDENCY_MODE is AUTO or EU and jurisdiction is GDPR, S3 operations fail closed if unset.
# EU_S3_BUCKET=
