# Voice telephony provider (default: twilio). Set to telnyx when ready to cut over.
# VOICE_TELEPHONY_PROVIDER=twilio

# --- Voice turn personalization (per-resident VAD silence; see docs/VOICE_TURN_PERSONALIZATION.md) ---
# AUDIO_TURN_PERSONALIZATION_ENABLED=true
# AUDIO_TURN_DEFAULT_SILENCE_DURATION_MS=300
# AUDIO_TURN_MIN_SILENCE_DURATION_MS=225
# AUDIO_TURN_MAX_SILENCE_DURATION_MS=2000
# AUDIO_TURN_INTERRUPTION_BUMP_MS=250
# AUDIO_TURN_SUCCESS_DECAY_MS=50
# AUDIO_TURN_SUCCESS_DECAY_MIN_TURNS=6
# AUDIO_TURN_SUCCESS_DECAY_MIN_CALLS=1
# AUDIO_TURN_PROFILE_ALPHA=0.35
# Legacy global fallback when personalization disabled:
# AUDIO_TURN_DETECTION_SILENCE_DURATION_MS=500

# Telnyx Call Control / TeXML (optional until cutover)
# TELNYX_API_KEY=
# TELNYX_CONNECTION_ID=
# TELNYX_PHONE_NUMBER=           # Default outbound caller ID (used for CA orgs and any non-US org)
# TELNYX_PHONE_US=               # US outbound caller ID (used for orgs with country=US)
# TELNYX_PUBLIC_KEY=

# Twilio outbound caller ID per jurisdiction
# TWILIO_PHONE_US=+19285758645   # US outbound caller ID (used for orgs with country=US; TWILIO_PHONENUMBER is used for CA and other orgs)

# --- Family portal (optional local overrides; staging/production use docker env + domain defaults) ---
# MOBILE_APP_URL=http://localhost:8084
# IOS_APP_STORE_URL=          # optional; set in AWS Secrets Manager when App Store listing exists
# ANDROID_PLAY_STORE_URL=     # optional; defaults to Google Play listing for com.negascout.bianca
