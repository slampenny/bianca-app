<?php
/**
 * Plugin Name: AWS SES SMTP Configuration
 * Description: Configures WordPress to send mail via AWS SES SMTP.
 *
 * Copy to aws-ses-smtp.php (gitignored) or define SES_* constants in wp-config.php on the server.
 */

add_action( 'phpmailer_init', 'bianca_configure_ses_smtp' );

function bianca_configure_ses_smtp( $phpmailer ) {
	if ( ! defined( 'SES_SMTP_USERNAME' ) || ! defined( 'SES_SMTP_PASSWORD' ) ) {
		return;
	}

	$phpmailer->isSMTP();
	$phpmailer->Host       = 'email-smtp.us-east-2.amazonaws.com';
	$phpmailer->SMTPAuth   = true;
	$phpmailer->Port       = 587;
	$phpmailer->SMTPSecure = 'tls';
	$phpmailer->SMTPAutoTLS = true;
	$phpmailer->Username   = SES_SMTP_USERNAME;
	$phpmailer->Password   = SES_SMTP_PASSWORD;
	$phpmailer->From       = defined( 'SES_FROM_EMAIL' ) ? SES_FROM_EMAIL : 'noreply@biancawellness.com';
	$phpmailer->FromName   = defined( 'SES_FROM_NAME' ) ? SES_FROM_NAME : 'Bianca Wellness';
}
