<?php
/**
 * Local marketing WordPress config — copy to wordpress/wp-config.php (gitignored).
 *
 *   cp wp-config.php.example wordpress/wp-config.php
 *
 * Do not commit wordpress/wp-config.php (may contain SES SMTP credentials on server pulls).
 */

define( 'DB_NAME', 'biancawellness' );
define( 'DB_USER', 'wordpress' );
define( 'DB_PASSWORD', 'wordpress' );
define( 'DB_HOST', 'db:3306' );
define( 'DB_CHARSET', 'utf8' );
define( 'DB_COLLATE', '' );

/** Generate fresh salts: https://api.wordpress.org/secret-key/1.1/salt/ */
define( 'AUTH_KEY', 'put-your-unique-phrase-here' );
define( 'SECURE_AUTH_KEY', 'put-your-unique-phrase-here' );
define( 'LOGGED_IN_KEY', 'put-your-unique-phrase-here' );
define( 'NONCE_KEY', 'put-your-unique-phrase-here' );
define( 'AUTH_SALT', 'put-your-unique-phrase-here' );
define( 'SECURE_AUTH_SALT', 'put-your-unique-phrase-here' );
define( 'LOGGED_IN_SALT', 'put-your-unique-phrase-here' );
define( 'NONCE_SALT', 'put-your-unique-phrase-here' );

$table_prefix = 'eMd_';

define( 'WP_DEBUG', true );
define( 'WP_DEBUG_LOG', true );
define( 'WP_DEBUG_DISPLAY', false );

$bianca_http_host = '';
if ( isset( $_SERVER['HTTP_HOST'] ) && is_string( $_SERVER['HTTP_HOST'] ) ) {
	$bianca_http_host = strtolower( trim( $_SERVER['HTTP_HOST'] ) );
}
$bianca_host_base = preg_replace( '/:\d+$/', '', $bianca_http_host );
$bianca_is_loopback = in_array(
	$bianca_host_base,
	array( 'localhost', '127.0.0.1', '[::1]', '::1' ),
	true
);

if ( $bianca_http_host !== '' ) {
	if ( $bianca_is_loopback ) {
		$bianca_site_url = 'http://' . $bianca_http_host;
	} elseif ( strpos( $bianca_http_host, 'biancawellness.com' ) !== false ) {
		$bianca_site_url = 'https://' . $bianca_http_host;
	} else {
		$bianca_site_url = 'https://biancawellness.com';
	}
} elseif ( defined( 'DB_HOST' ) && 'db:3306' === DB_HOST ) {
	$bianca_site_url = 'http://localhost:8085';
} else {
	$bianca_site_url = 'https://biancawellness.com';
}

define( 'WP_HOME', $bianca_site_url );
define( 'WP_SITEURL', $bianca_site_url );
define( 'FORCE_SSL_ADMIN', false );

// Optional — configure on Lightsail wp-config directly; do not commit real values.
// define( 'SES_SMTP_USERNAME', '' );
// define( 'SES_SMTP_PASSWORD', '' );
// define( 'SES_FROM_EMAIL', 'noreply@biancawellness.com' );
// define( 'SES_FROM_NAME', 'Bianca Wellness' );

if ( ! defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}

require_once ABSPATH . 'wp-settings.php';
