# API base (…/v1). Required for production builds.
# VITE_API_URL=https://api.example.com/v1

# SSO — same OAuth apps as facility web; add admin origin as authorized redirect (redirect_uri is origin only).
# VITE_GOOGLE_CLIENT_ID=
# VITE_MICROSOFT_CLIENT_ID=
# VITE_MICROSOFT_TENANT_ID=common

# Optional: Grafana root URL for the Observability page (development defaults to http://localhost:3333).
# VITE_GRAFANA_URL=https://grafana.example.com
